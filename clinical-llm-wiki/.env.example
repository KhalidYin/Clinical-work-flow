# 复制为 .env，并在运行 Compose 前替换所有占位值。
# .env 已被 Git 忽略；初始管理员首次登录后必须修改引导密码。

KNOWLEDGE_POSTGRES_PASSWORD=replace-with-a-random-database-password

KNOWLEDGE_ADMIN_USERNAME=admin
KNOWLEDGE_ADMIN_PASSWORD=replace-with-a-12-character-or-longer-initial-password
KNOWLEDGE_ADMIN_DISPLAY_NAME=系统管理员
KNOWLEDGE_ADMIN_EMAIL=admin@knowledge.local
KNOWLEDGE_ADMIN_INITIAL_PASSWORD_MIN_LENGTH=12
# 开发环境可设为 false 跳过首次登录强制改密（生产环境须保持 true）
KNOWLEDGE_ADMIN_REQUIRE_PASSWORD_CHANGE=true

KNOWLEDGE_DOCUMENT_WORKER_SERVICE_ACCOUNT_ID=svc-demo-document
KNOWLEDGE_ENRICHMENT_WORKER_SERVICE_ACCOUNT_ID=svc-demo-enrichment
KNOWLEDGE_RELEASE_WORKER_SERVICE_ACCOUNT_ID=svc-demo-release
P12_DOCUMENT_WORKER_TOKEN=replace-with-a-random-document-worker-secret
P12_ENRICHMENT_WORKER_TOKEN=replace-with-a-random-enrichment-worker-secret
P12_RELEASE_WORKER_TOKEN=replace-with-a-random-release-worker-secret
KNOWLEDGE_RUNTIME_CONSUMER_SECRET=replace-with-a-random-workflow-consumer-secret

KNOWLEDGE_ORGANIZATION_NAME=临床知识平台
KNOWLEDGE_BIND_ADDRESS=0.0.0.0
