__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Rebuildable service and source-pipeline state
indexes/
snapshots/generated/
sources/**/derived/
tmp/
*.log

# Secrets and local-only source material
.env
.env.local
!.env.example
.demo-runtime/
sources/**/original/
!sources/**/original/.gitkeep
sources/accessions/*.pdf
sources/accessions/*.xlsx

# Obsidian local session state is not shared; stable settings live in vault/.obsidian.
vault/.obsidian/workspace*.json

# Restricted attachments require separate controlled storage and must never enter Git.
vault/90_System/Attachments/Sources/restricted-local/**
!vault/90_System/Attachments/Sources/restricted-local/.gitkeep
