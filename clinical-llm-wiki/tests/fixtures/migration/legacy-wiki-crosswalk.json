  "reported_findings": [
    {
      "id": 1,
      "decision": "preserve_legacy_hash_semantics",
      "reason": "changing the trailing-LF algorithm would invalidate historical artifact locks"
    },
    {
      "id": 2,
      "decision": "delete_duplicate_old_loader_after_cross-check",
      "reason": "the old SchemaBundle loader belongs to the retiring 8787 service"
    },
    {
      "id": 3,
      "decision": "delete_old_resolver",
      "reason": "the hard-coded stage set belongs to the retiring Vault resolver"
    },
    {
      "id": 4,
      "decision": "delete_old_snapshot_service",
      "reason": "P12 immutable Release replaces the legacy snapshot implementation"
    },
    {
      "id": 5,
      "decision": "new_migration_scanner_must_fail_closed",
      "reason": "malformed YAML cannot disappear from the migration inventory"
    },
    {
      "id": 6,
      "decision": "leave_workflow_behavior_unchanged",
      "reason": "helper duplication in the P9 workflow is not a P13 runtime blocker"
    },
    {
      "id": 7,
      "decision": "preserve_prerelease_contract_until_explicit_migration",
      "reason": "changing 0.1.0 without a compatibility migration would break old receipts"
    }
