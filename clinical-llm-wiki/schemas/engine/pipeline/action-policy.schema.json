{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-ai-workflow.local/schemas/pipeline/action-policy.schema.json",
  "title": "Clinical Action Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "tools", "executables"],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "tools": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {"$ref": "#/$defs/tool_registration"},
      "allOf": [
        {"contains": {"$ref": "#/$defs/tool_sdtm_spec_build"}},
        {"contains": {"$ref": "#/$defs/tool_adam_spec_build"}},
        {"contains": {"$ref": "#/$defs/tool_tfl_shells_list"}},
        {"contains": {"$ref": "#/$defs/tool_cdisc_validate"}},
        {"contains": {"$ref": "#/$defs/tool_define_xml_build"}},
        {"contains": {"$ref": "#/$defs/tool_triage_p21"}},
        {"contains": {"$ref": "#/$defs/tool_edc_import"}},
        {"contains": {"$ref": "#/$defs/tool_ctgov_search"}},
        {"contains": {"$ref": "#/$defs/tool_ctgov_study_detail"}},
        {"contains": {"$ref": "#/$defs/tool_ctgov_download_docs"}},
        {"contains": {"$ref": "#/$defs/tool_ctgov_check_docs"}}
      ]
    },
    "executables": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/executable_registration"},
      "allOf": [
        {"contains": {"$ref": "#/$defs/executable_protocol_document_parser"}},
        {"contains": {"$ref": "#/$defs/executable_sap_document_generator"}},
        {"contains": {"$ref": "#/$defs/executable_sdtm_program_runner"}},
        {"contains": {"$ref": "#/$defs/executable_adam_program_runner"}},
        {"contains": {"$ref": "#/$defs/executable_tfl_renderer"}},
        {"contains": {"$ref": "#/$defs/executable_qc_comparator"}},
        {"contains": {"$ref": "#/$defs/executable_submission_packager"}}
      ]
    }
  },
  "$defs": {
    "stage_id": {"enum": ["protocol_analysis", "sap_generation", "sdtm_spec", "sdtm_programming", "adam_spec", "adam_programming", "tfl_shell_design", "tfl_programming", "qc_validation", "submission_packaging"]},
    "capability": {"enum": ["protocol_analysis", "endpoint_classification", "estimands_derivation", "sap_generation", "sdtm_spec_generation", "sdtm_programming", "adam_spec_generation", "adam_programming", "ct_alignment", "cdisc_validation", "tfl_shell_generation", "tfl_programming", "qc_validation", "p21_triage", "define_xml_generation", "submission_packaging", "source_discovery", "source_data_import"]},
    "tool_name": {"enum": ["sdtm_spec_build", "adam_spec_build", "tfl_shells_list", "cdisc_validate", "define_xml_build", "triage_p21", "edc_import", "ctgov_search", "ctgov_study_detail", "ctgov_download_docs", "ctgov_check_docs"]},
    "executable_name": {"enum": ["protocol_document_parser", "sap_document_generator", "sdtm_program_runner", "adam_program_runner", "tfl_renderer", "qc_comparator", "submission_packager"]},
    "tool_registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "classification", "capability", "allowed_stages"],
      "properties": {
        "name": {"$ref": "#/$defs/tool_name"},
        "classification": {"enum": ["core", "auxiliary"]},
        "capability": {"$ref": "#/$defs/capability"},
        "allowed_stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stage_id"}}
      }
    },
    "executable_registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "capability", "allowed_stages", "isolated_runtime_required", "arbitrary_command_allowed"],
      "properties": {
        "name": {"$ref": "#/$defs/executable_name"},
        "capability": {"$ref": "#/$defs/capability"},
        "allowed_stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stage_id"}},
        "isolated_runtime_required": {"const": true},
        "arbitrary_command_allowed": {"const": false}
      }
    },
    "tool_sdtm_spec_build": {"properties": {"name": {"const": "sdtm_spec_build"}, "classification": {"const": "core"}, "capability": {"const": "sdtm_spec_generation"}, "allowed_stages": {"const": ["sdtm_spec"]}}},
    "tool_adam_spec_build": {"properties": {"name": {"const": "adam_spec_build"}, "classification": {"const": "core"}, "capability": {"const": "adam_spec_generation"}, "allowed_stages": {"const": ["adam_spec"]}}},
    "tool_tfl_shells_list": {"properties": {"name": {"const": "tfl_shells_list"}, "classification": {"const": "core"}, "capability": {"const": "tfl_shell_generation"}, "allowed_stages": {"const": ["tfl_shell_design"]}}},
    "tool_cdisc_validate": {"properties": {"name": {"const": "cdisc_validate"}, "classification": {"const": "core"}, "capability": {"const": "cdisc_validation"}, "allowed_stages": {"const": ["sdtm_spec", "sdtm_programming", "adam_spec", "adam_programming", "qc_validation"]}}},
    "tool_define_xml_build": {"properties": {"name": {"const": "define_xml_build"}, "classification": {"const": "core"}, "capability": {"const": "define_xml_generation"}, "allowed_stages": {"const": ["submission_packaging"]}}},
    "tool_triage_p21": {"properties": {"name": {"const": "triage_p21"}, "classification": {"const": "core"}, "capability": {"const": "p21_triage"}, "allowed_stages": {"const": ["qc_validation"]}}},
    "tool_edc_import": {"properties": {"name": {"const": "edc_import"}, "classification": {"const": "auxiliary"}, "capability": {"const": "source_data_import"}, "allowed_stages": {"const": ["sdtm_spec", "sdtm_programming"]}}},
    "tool_ctgov_search": {"properties": {"name": {"const": "ctgov_search"}, "classification": {"const": "auxiliary"}, "capability": {"const": "source_discovery"}, "allowed_stages": {"const": ["protocol_analysis"]}}},
    "tool_ctgov_study_detail": {"properties": {"name": {"const": "ctgov_study_detail"}, "classification": {"const": "auxiliary"}, "capability": {"const": "source_discovery"}, "allowed_stages": {"const": ["protocol_analysis"]}}},
    "tool_ctgov_download_docs": {"properties": {"name": {"const": "ctgov_download_docs"}, "classification": {"const": "auxiliary"}, "capability": {"const": "source_discovery"}, "allowed_stages": {"const": ["protocol_analysis"]}}},
    "tool_ctgov_check_docs": {"properties": {"name": {"const": "ctgov_check_docs"}, "classification": {"const": "auxiliary"}, "capability": {"const": "source_discovery"}, "allowed_stages": {"const": ["protocol_analysis"]}}},
    "executable_protocol_document_parser": {"properties": {"name": {"const": "protocol_document_parser"}, "capability": {"const": "protocol_analysis"}, "allowed_stages": {"const": ["protocol_analysis"]}}},
    "executable_sap_document_generator": {"properties": {"name": {"const": "sap_document_generator"}, "capability": {"const": "sap_generation"}, "allowed_stages": {"const": ["sap_generation"]}}},
    "executable_sdtm_program_runner": {"properties": {"name": {"const": "sdtm_program_runner"}, "capability": {"const": "sdtm_programming"}, "allowed_stages": {"const": ["sdtm_programming"]}}},
    "executable_adam_program_runner": {"properties": {"name": {"const": "adam_program_runner"}, "capability": {"const": "adam_programming"}, "allowed_stages": {"const": ["adam_programming"]}}},
    "executable_tfl_renderer": {"properties": {"name": {"const": "tfl_renderer"}, "capability": {"const": "tfl_programming"}, "allowed_stages": {"const": ["tfl_programming"]}}},
    "executable_qc_comparator": {"properties": {"name": {"const": "qc_comparator"}, "capability": {"const": "qc_validation"}, "allowed_stages": {"const": ["qc_validation"]}}},
    "executable_submission_packager": {"properties": {"name": {"const": "submission_packager"}, "capability": {"const": "submission_packaging"}, "allowed_stages": {"const": ["submission_packaging"]}}}
  },
  "x-core-tool-names": ["sdtm_spec_build", "adam_spec_build", "tfl_shells_list", "cdisc_validate", "define_xml_build", "triage_p21"],
  "x-auxiliary-tool-names": ["edc_import", "ctgov_search", "ctgov_study_detail", "ctgov_download_docs", "ctgov_check_docs"]
}
