{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-workflow/schemas/knowledge/execution-context",
  "$defs": {
    "ArtifactLock": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "version",
        "sha256"
      ],
      "title": "ArtifactLock",
      "type": "object"
    },
    "ContextConflict": {
      "additionalProperties": false,
      "properties": {
        "conflict_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
          "title": "Conflict Id",
          "type": "string"
        },
        "rule_ids": {
          "items": {
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
            "type": "string"
          },
          "minItems": 2,
          "title": "Rule Ids",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        }
      },
      "required": [
        "conflict_id",
        "rule_ids",
        "reason"
      ],
      "title": "ContextConflict",
      "type": "object"
    },
    "MissingRequirement": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
          "title": "Requirement Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "blocking": {
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        }
      },
      "required": [
        "requirement_id",
        "description"
      ],
      "title": "MissingRequirement",
      "type": "object"
    },
    "ProvenanceEntry": {
      "additionalProperties": false,
      "properties": {
        "provenance_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
          "title": "Provenance Id",
          "type": "string"
        },
        "object_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
          "title": "Object Id",
          "type": "string"
        },
        "object_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Object Version",
          "type": "string"
        },
        "object_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Object Sha256",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "pipeline_contract",
            "workflow_knowledge",
            "domain_knowledge",
            "study_decision"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "minLength": 3,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Id"
        },
        "audit_reference": {
          "minLength": 1,
          "title": "Audit Reference",
          "type": "string"
        }
      },
      "required": [
        "provenance_id",
        "object_id",
        "object_version",
        "object_sha256",
        "source_kind",
        "audit_reference"
      ],
      "title": "ProvenanceEntry",
      "type": "object"
    },
    "ResolvedRule": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
          "title": "Rule Id",
          "type": "string"
        },
        "layer": {
          "$ref": "#/$defs/RuleLayer"
        },
        "priority": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "minLength": 3,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "source_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Source Version",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "approval_receipt_id": {
          "minLength": 1,
          "title": "Approval Receipt Id",
          "type": "string"
        },
        "structured_rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/TEAEWindowRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "rule_id",
        "layer",
        "priority",
        "title",
        "statement",
        "source_ids",
        "source_version",
        "source_sha256",
        "approval_receipt_id"
      ],
      "title": "ResolvedRule",
      "type": "object"
    },
    "RuleLayer": {
      "enum": [
        "workflow",
        "domain",
        "study"
      ],
      "title": "RuleLayer",
      "type": "string"
    },
    "TEAEWindowRule": {
      "additionalProperties": false,
      "description": "Machine-executable treatment-emergent adverse-event window.",
      "properties": {
        "rule_type": {
          "const": "teae_window",
          "default": "teae_window",
          "title": "Rule Type",
          "type": "string"
        },
        "target_dataset": {
          "const": "ADAE",
          "default": "ADAE",
          "title": "Target Dataset",
          "type": "string"
        },
        "target_variable": {
          "const": "TRTEMFL",
          "default": "TRTEMFL",
          "title": "Target Variable",
          "type": "string"
        },
        "event_start_date": {
          "const": "ADAE.ASTDT",
          "default": "ADAE.ASTDT",
          "title": "Event Start Date",
          "type": "string"
        },
        "treatment_start_date": {
          "const": "ADSL.TRTSDT",
          "default": "ADSL.TRTSDT",
          "title": "Treatment Start Date",
          "type": "string"
        },
        "treatment_end_date": {
          "const": "ADSL.TRTEDT",
          "default": "ADSL.TRTEDT",
          "title": "Treatment End Date",
          "type": "string"
        },
        "start_offset_days": {
          "default": 0,
          "maximum": 365,
          "minimum": -365,
          "title": "Start Offset Days",
          "type": "integer"
        },
        "end_offset_days": {
          "maximum": 365,
          "minimum": 0,
          "title": "End Offset Days",
          "type": "integer"
        },
        "lower_bound_inclusive": {
          "default": true,
          "title": "Lower Bound Inclusive",
          "type": "boolean"
        },
        "upper_bound_inclusive": {
          "default": true,
          "title": "Upper Bound Inclusive",
          "type": "boolean"
        },
        "incomplete_event_date_policy": {
          "const": "review_required",
          "title": "Incomplete Event Date Policy",
          "type": "string"
        },
        "missing_treatment_date_policy": {
          "const": "review_required",
          "title": "Missing Treatment Date Policy",
          "type": "string"
        },
        "multiple_treatment_period_policy": {
          "const": "review_required",
          "title": "Multiple Treatment Period Policy",
          "type": "string"
        },
        "pre_treatment_worsening_policy": {
          "enum": [
            "review_required",
            "include_if_worsened"
          ],
          "title": "Pre Treatment Worsening Policy",
          "type": "string"
        }
      },
      "required": [
        "end_offset_days",
        "incomplete_event_date_policy",
        "missing_treatment_date_policy",
        "multiple_treatment_period_policy",
        "pre_treatment_worsening_policy"
      ],
      "title": "TEAEWindowRule",
      "type": "object"
    },
    "WorkflowStage": {
      "enum": [
        "protocol_analysis",
        "sap_generation",
        "sdtm_spec",
        "sdtm_programming",
        "adam_spec",
        "adam_programming",
        "tfl_shell_design",
        "tfl_programming",
        "qc_validation",
        "submission_packaging"
      ],
      "title": "WorkflowStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "pattern": "^ctx-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Bundle Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "study_id": {
      "minLength": 1,
      "title": "Study Id",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/WorkflowStage"
    },
    "resolved_at": {
      "format": "date-time",
      "title": "Resolved At",
      "type": "string"
    },
    "manifest_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
      "title": "Manifest Id",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "pipeline_contract": {
      "$ref": "#/$defs/ArtifactLock"
    },
    "workflow_rules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResolvedRule"
      },
      "title": "Workflow Rules",
      "type": "array"
    },
    "domain_rules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResolvedRule"
      },
      "title": "Domain Rules",
      "type": "array"
    },
    "study_rules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResolvedRule"
      },
      "title": "Study Rules",
      "type": "array"
    },
    "conflicts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContextConflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "missing_requirements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MissingRequirement"
      },
      "title": "Missing Requirements",
      "type": "array"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ProvenanceEntry"
      },
      "minItems": 1,
      "title": "Provenance",
      "type": "array"
    },
    "executable": {
      "title": "Executable",
      "type": "boolean"
    },
    "execution_context_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Execution Context Sha256",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "schema_version",
    "study_id",
    "stage",
    "resolved_at",
    "manifest_id",
    "manifest_sha256",
    "pipeline_contract",
    "provenance",
    "executable",
    "execution_context_sha256"
  ],
  "title": "ExecutionContext",
  "type": "object"
}
