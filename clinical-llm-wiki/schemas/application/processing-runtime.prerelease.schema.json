{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical.example/schemas/processing-runtime.prerelease.schema.json",
  "title": "P12 Processing Runtime Prerelease Contract",
  "$defs": {
    "ArtifactManifest": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObjectDescriptor"
          },
          "title": "Artifacts",
          "type": "array"
        }
      },
      "title": "ArtifactManifest",
      "type": "object"
    },
    "AttemptStatus": {
      "enum": [
        "queued",
        "leased",
        "succeeded",
        "failed",
        "expired",
        "cancelled"
      ],
      "title": "AttemptStatus",
      "type": "string"
    },
    "ClaimedStepAttempt": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "step_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        },
        "step_key": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Step Key",
          "type": "string"
        },
        "pool": {
          "$ref": "#/$defs/WorkerPool"
        },
        "attempt_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "attempt_number": {
          "minimum": 1,
          "title": "Attempt Number",
          "type": "integer"
        },
        "previous_attempt_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Attempt Id"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "checkpoint": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint"
        },
        "executor_kind": {
          "default": "deterministic_handler",
          "enum": [
            "deterministic_handler",
            "direct_model",
            "harness"
          ],
          "title": "Executor Kind",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "step_id",
        "step_key",
        "pool",
        "attempt_id",
        "attempt_number",
        "input_sha256"
      ],
      "title": "ClaimedStepAttempt",
      "type": "object"
    },
    "ObjectDescriptor": {
      "additionalProperties": false,
      "description": "Business-safe object identity; it contains no path or provider URL.",
      "properties": {
        "object_key": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Object Key",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "object_key",
        "sha256",
        "media_type",
        "size_bytes"
      ],
      "title": "ObjectDescriptor",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "queued",
        "processing",
        "evidence_ready",
        "author_confirmation_required",
        "review_required",
        "approved",
        "release_blocked",
        "released",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "StepDefinition": {
      "additionalProperties": false,
      "properties": {
        "step_key": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Step Key",
          "type": "string"
        },
        "pool": {
          "$ref": "#/$defs/WorkerPool"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "executor_kind": {
          "default": "deterministic_handler",
          "enum": [
            "deterministic_handler",
            "direct_model",
            "harness"
          ],
          "title": "Executor Kind",
          "type": "string"
        }
      },
      "required": [
        "step_key",
        "pool",
        "input_sha256"
      ],
      "title": "StepDefinition",
      "type": "object"
    },
    "StepOutcome": {
      "additionalProperties": false,
      "properties": {
        "output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "artifact_manifest": {
          "$ref": "#/$defs/ArtifactManifest"
        }
      },
      "required": [
        "output_sha256",
        "artifact_manifest"
      ],
      "title": "StepOutcome",
      "type": "object"
    },
    "StepStatus": {
      "enum": [
        "queued",
        "processing",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "StepStatus",
      "type": "string"
    },
    "WorkerPool": {
      "enum": [
        "document",
        "enrichment",
        "release"
      ],
      "title": "WorkerPool",
      "type": "string"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/RunStatus"
    },
    {
      "$ref": "#/$defs/StepStatus"
    },
    {
      "$ref": "#/$defs/AttemptStatus"
    },
    {
      "$ref": "#/$defs/StepDefinition"
    },
    {
      "$ref": "#/$defs/ArtifactManifest"
    },
    {
      "$ref": "#/$defs/ClaimedStepAttempt"
    },
    {
      "$ref": "#/$defs/StepOutcome"
    }
  ]
}
