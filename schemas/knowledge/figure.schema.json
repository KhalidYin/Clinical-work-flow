{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-workflow/schemas/knowledge/figure",
  "$defs": {
    "Applicability": {
      "additionalProperties": false,
      "properties": {
        "therapeutic_areas": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Therapeutic Areas",
          "type": "array"
        },
        "trial_phases": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Trial Phases",
          "type": "array"
        },
        "sponsor_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Sponsor Ids",
          "type": "array"
        },
        "study_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Study Ids",
          "type": "array"
        },
        "conditions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        }
      },
      "title": "Applicability",
      "type": "object"
    },
    "ApprovalStatus": {
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "superseded"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "Authority": {
      "enum": [
        "regulatory",
        "industry_standard",
        "company_sop",
        "domain_expert",
        "approved_precedent",
        "study_decision",
        "ai_inference"
      ],
      "title": "Authority",
      "type": "string"
    },
    "CompatibilityRange": {
      "additionalProperties": false,
      "description": "Half-open SemVer range: minimum <= version < maximum_exclusive.",
      "properties": {
        "minimum": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Minimum",
          "type": "string"
        },
        "maximum_exclusive": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Maximum Exclusive",
          "type": "string"
        }
      },
      "required": [
        "minimum",
        "maximum_exclusive"
      ],
      "title": "CompatibilityRange",
      "type": "object"
    },
    "ContentStatus": {
      "enum": [
        "inbox",
        "draft",
        "reviewed",
        "verified",
        "deprecated",
        "archived"
      ],
      "title": "ContentStatus",
      "type": "string"
    },
    "DerivationRecord": {
      "additionalProperties": false,
      "properties": {
        "derivation_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
          "title": "Derivation Id",
          "type": "string"
        },
        "tool": {
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "output_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "parameters_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Parameters Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "derivation_id",
        "tool",
        "tool_version",
        "input_sha256",
        "output_sha256",
        "parameters_sha256",
        "created_at"
      ],
      "title": "DerivationRecord",
      "type": "object"
    },
    "EvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "physical_page": {
          "minimum": 1,
          "title": "Physical Page",
          "type": "integer"
        },
        "printed_page": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Printed Page"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        }
      },
      "required": [
        "physical_page"
      ],
      "title": "EvidenceLocator",
      "type": "object"
    },
    "RightsStatus": {
      "enum": [
        "cleared",
        "restricted",
        "prohibited",
        "unknown"
      ],
      "title": "RightsStatus",
      "type": "string"
    },
    "StorageMode": {
      "enum": [
        "committed",
        "local_only",
        "link_only",
        "unknown"
      ],
      "title": "StorageMode",
      "type": "string"
    },
    "WorkflowStage": {
      "enum": [
        "protocol_analysis",
        "sap_generation",
        "sdtm_spec",
        "sdtm_programming",
        "adam_spec",
        "adam_programming",
        "tfl_shell_design",
        "tfl_programming",
        "qc_validation",
        "submission_packaging"
      ],
      "title": "WorkflowStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^fig-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "type": {
      "const": "figure_record",
      "title": "Type",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Version",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "content_status": {
      "$ref": "#/$defs/ContentStatus"
    },
    "approval_status": {
      "$ref": "#/$defs/ApprovalStatus"
    },
    "domains": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Domains",
      "type": "array"
    },
    "workflow_stages": {
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkflowStage"
      },
      "title": "Workflow Stages",
      "type": "array"
    },
    "topics": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Topics",
      "type": "array"
    },
    "aliases": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "authority": {
      "$ref": "#/$defs/Authority"
    },
    "applicability": {
      "$ref": "#/$defs/Applicability"
    },
    "sources": {
      "default": [],
      "items": {
        "minLength": 3,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "owner": {
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "created": {
      "format": "date-time",
      "title": "Created",
      "type": "string"
    },
    "last_reviewed": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Reviewed"
    },
    "review_due": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Due"
    },
    "supersedes": {
      "default": [],
      "items": {
        "minLength": 3,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
        "type": "string"
      },
      "title": "Supersedes",
      "type": "array"
    },
    "superseded_by": {
      "anyOf": [
        {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Superseded By"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "rights_status": {
      "$ref": "#/$defs/RightsStatus"
    },
    "allowed_uses": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Allowed Uses",
      "type": "array"
    },
    "storage_mode": {
      "$ref": "#/$defs/StorageMode"
    },
    "contract_compatibility": {
      "$ref": "#/$defs/CompatibilityRange"
    },
    "approval_receipt_id": {
      "anyOf": [
        {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Receipt Id"
    },
    "audit_reference": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audit Reference"
    },
    "source_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
      "title": "Source Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "figure_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Figure Sha256",
      "type": "string"
    },
    "locator": {
      "$ref": "#/$defs/EvidenceLocator"
    },
    "caption": {
      "minLength": 1,
      "title": "Caption",
      "type": "string"
    },
    "derivation": {
      "$ref": "#/$defs/DerivationRecord"
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "version",
    "content_status",
    "approval_status",
    "authority",
    "applicability",
    "owner",
    "created",
    "content_hash",
    "rights_status",
    "storage_mode",
    "contract_compatibility",
    "source_id",
    "source_sha256",
    "figure_sha256",
    "locator",
    "caption",
    "derivation"
  ],
  "title": "FigureRecord",
  "type": "object"
}
