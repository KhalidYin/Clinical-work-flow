{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-ai-workflow.local/schemas/pipeline/pipeline-contract.schema.json",
  "title": "Clinical Pipeline Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "stages"],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "stages": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"ordinal": {"const": 1}, "stage_id": {"const": "protocol_analysis"}, "depends_on": {"const": []}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"ordinal": {"const": 2}, "stage_id": {"const": "sap_generation"}, "depends_on": {"const": ["protocol_analysis"]}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"ordinal": {"const": 3}, "stage_id": {"const": "sdtm_spec"}, "depends_on": {"const": ["sap_generation"]}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"ordinal": {"const": 4}, "stage_id": {"const": "sdtm_programming"}, "depends_on": {"const": ["sdtm_spec"]}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"ordinal": {"const": 5}, "stage_id": {"const": "adam_spec"}, "depends_on": {"const": ["sdtm_programming"]}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"ordinal": {"const": 6}, "stage_id": {"const": "adam_programming"}, "depends_on": {"const": ["adam_spec"]}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"ordinal": {"const": 7}, "stage_id": {"const": "tfl_shell_design"}, "depends_on": {"const": ["adam_programming"]}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"ordinal": {"const": 8}, "stage_id": {"const": "tfl_programming"}, "depends_on": {"const": ["tfl_shell_design"]}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"ordinal": {"const": 9}, "stage_id": {"const": "qc_validation"}, "depends_on": {"const": ["tfl_programming"]}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"ordinal": {"const": 10}, "stage_id": {"const": "submission_packaging"}, "depends_on": {"const": ["qc_validation"]}}}]}
      ],
      "items": false
    }
  },
  "$defs": {
    "stage_id": {"enum": ["protocol_analysis", "sap_generation", "sdtm_spec", "sdtm_programming", "adam_spec", "adam_programming", "tfl_shell_design", "tfl_programming", "qc_validation", "submission_packaging"]},
    "executor": {"enum": ["ProtocolSAPAgent", "DataStandardsAgent", "TFLQCSubmissionAgent"]},
    "capability": {"enum": ["protocol_analysis", "endpoint_classification", "estimands_derivation", "sap_generation", "sdtm_spec_generation", "sdtm_programming", "adam_spec_generation", "adam_programming", "ct_alignment", "cdisc_validation", "tfl_shell_generation", "tfl_programming", "qc_validation", "p21_triage", "define_xml_generation", "submission_packaging", "source_discovery", "source_data_import"]},
    "tool": {"enum": ["sdtm_spec_build", "adam_spec_build", "tfl_shells_list", "cdisc_validate", "define_xml_build", "triage_p21", "edc_import", "ctgov_search", "ctgov_study_detail", "ctgov_download_docs", "ctgov_check_docs"]},
    "executable": {"enum": ["protocol_document_parser", "sap_document_generator", "sdtm_program_runner", "adam_program_runner", "tfl_renderer", "qc_comparator", "submission_packager"]},
    "artifact": {"enum": ["protocol_document", "study_facts", "protocol_analysis", "sap", "crf_metadata", "edc_metadata", "sdtm_specs", "approved_sdtm_specs", "sdtm_programs", "sdtm_datasets", "adam_specs", "approved_adam_specs", "adam_programs", "adam_datasets", "tfl_shells", "approved_tfl_shells", "tfl_programs", "tfl_outputs", "all_work_products", "approved_outputs", "qc_report", "qc_evidence", "submission_manifest", "submission_package"]},
    "unique_stage_ids": {"type": "array", "items": {"$ref": "#/$defs/stage_id"}, "uniqueItems": true},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "stage_id", "display_name", "executor", "depends_on", "required_inputs", "canonical_outputs", "completion_evidence", "allowed_capabilities", "allowed_tools", "allowed_executables"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 10},
        "stage_id": {"$ref": "#/$defs/stage_id"},
        "display_name": {"type": "string", "minLength": 1},
        "executor": {"$ref": "#/$defs/executor"},
        "depends_on": {"$ref": "#/$defs/unique_stage_ids"},
        "required_inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
        "canonical_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
        "completion_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"allOf": [{"type": "string", "pattern": "^output/"}, {"not": {"enum": ["output/programs", "output/programs/"]}}]}},
        "allowed_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}},
        "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/tool"}},
        "allowed_executables": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/executable"}}
      }
    }
  },
  "x-canonical-stage-order": ["protocol_analysis", "sap_generation", "sdtm_spec", "sdtm_programming", "adam_spec", "adam_programming", "tfl_shell_design", "tfl_programming", "qc_validation", "submission_packaging"]
}
