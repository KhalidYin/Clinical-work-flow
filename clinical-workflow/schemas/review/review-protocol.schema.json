{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-workflow/schemas/review-protocol",
  "title": "Clinical Review Protocol Schema Bundle",
  "type": "object",
  "$defs": {
    "review_finding": {
      "$id": "https://clinical-workflow/schemas/review-finding",
      "title": "ReviewFinding",
      "description": "A single finding that requires human attention.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "severity",
        "location",
        "title",
        "current_value",
        "proposed_value",
        "rationale",
        "evidence_refs",
        "auto_approved"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-[0-9]{3,}$"
        },
        "category": {
          "type": "string",
          "enum": [
            "mapping",
            "derivation",
            "population",
            "terminology",
            "compliance",
            "formatting"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "warning", "info"]
        },
        "location": {
          "type": "string",
          "minLength": 3
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "current_value": {
          "type": "string"
        },
        "proposed_value": {
          "type": "string"
        },
        "rationale": {
          "type": "string",
          "minLength": 10
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "auto_approved": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "review_packet": {
      "$id": "https://clinical-workflow/schemas/review-packet",
      "title": "ReviewPacket",
      "description": "Complete review submission from agent to human.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "review_type",
        "source_documents",
        "agent_summary",
        "findings",
        "urgency",
        "created_at",
        "generated_by",
        "auto_approved_count"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "pattern": "^[a-z]+_[a-z0-9_]+_v[0-9]+_[0-9]{3}$"
        },
        "review_type": {
          "type": "string",
          "enum": [
            "sdtm_spec",
            "adam_spec",
            "tfl_shell",
            "tfl_qc",
            "sap_review",
            "submission"
          ]
        },
        "source_documents": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "agent_summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/review_finding" },
          "minItems": 1
        },
        "urgency": {
          "type": "string",
          "enum": ["normal", "blocking"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "generated_by": {
          "type": "string",
          "minLength": 1
        },
        "auto_approved_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_reviewers": {
          "type": "array",
          "items": { "$ref": "#/$defs/reviewer_status" }
        },
        "consensus_rule": {
          "enum": ["all_must_approve", "majority", "any_one"]
        },
        "timeout_config": {
          "$ref": "#/$defs/timeout_config"
        }
      }
    },
    "finding_decision": {
      "$id": "https://clinical-workflow/schemas/finding-decision",
      "title": "FindingDecision",
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "decision"],
      "properties": {
        "finding_id": {
          "type": "string"
        },
        "decision": {
          "type": "string",
          "enum": ["approved", "rejected", "modified"]
        },
        "modified_value": {
          "type": "string"
        },
        "rejection_reason": {
          "type": "string",
          "enum": [
            "wrong_domain_assignment",
            "incorrect_variable_mapping",
            "incorrect_derivation",
            "wrong_ct_value",
            "missing_variable",
            "incorrect_population",
            "incorrect_method",
            "insufficient_evidence",
            "other"
          ]
        },
        "human_correction": {
          "type": "string",
          "minLength": 10
        },
        "reference": {
          "type": "string"
        },
        "comment": {
          "type": "string",
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "decision": { "const": "modified" } },
            "required": ["decision"]
          },
          "then": {
            "required": ["modified_value"],
            "properties": { "modified_value": { "minLength": 1 } }
          }
        },
        {
          "if": {
            "properties": { "decision": { "const": "rejected" } },
            "required": ["decision"]
          },
          "then": {
            "required": ["rejection_reason"],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "rejection_reason": {
                      "not": { "const": "insufficient_evidence" }
                    }
                  },
                  "required": ["rejection_reason"]
                },
                "then": { "required": ["human_correction"] }
              }
            ]
          }
        }
      ]
    },
    "decision_receipt": {
      "$id": "https://clinical-workflow/schemas/decision-receipt",
      "title": "DecisionReceipt",
      "description": "Human's structured response to a ReviewPacket.",
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "reviewer", "timestamp", "decisions"],
      "properties": {
        "review_id": {
          "type": "string"
        },
        "reviewer": {
          "type": "string",
          "minLength": 2
        },
        "reviewer_role": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "decisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding_decision" },
          "minItems": 1
        },
        "general_notes": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "confirmation_receipt": {
      "$id": "https://clinical-workflow/schemas/confirmation-receipt",
      "title": "ConfirmationReceipt",
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "applied_at", "results"],
      "properties": {
        "review_id": {
          "type": "string"
        },
        "applied_at": {
          "type": "string",
          "format": "date-time"
        },
        "generated_by": {
          "type": "string"
        },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/application_result" },
          "minItems": 1
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "applied": { "type": "integer", "minimum": 0 },
            "adjusted": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "application_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "original_decision", "application_status"],
      "properties": {
        "finding_id": {
          "type": "string"
        },
        "original_decision": {
          "enum": ["approved", "rejected", "modified"]
        },
        "application_status": {
          "enum": ["applied", "applied_with_adjustment", "failed"]
        },
        "actual_value": {
          "type": "string"
        },
        "adjustment_note": {
          "type": "string"
        },
        "error_message": {
          "type": "string"
        }
      }
    },
    "reviewer_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": { "type": "string" },
        "name": { "type": ["string", "null"] },
        "decision": {
          "type": ["string", "null"],
          "enum": ["approved", "rejected", "modified", null]
        },
        "decided_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "timeout_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reminder_hours": { "type": "integer", "minimum": 1 },
        "escalation_hours": { "type": "integer", "minimum": 1 },
        "stale_hours": { "type": "integer", "minimum": 1 },
        "escalation_contacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "name"],
            "properties": {
              "role": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
