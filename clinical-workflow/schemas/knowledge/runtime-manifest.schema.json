{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-workflow/schemas/knowledge/runtime-manifest",
  "$defs": {
    "ArtifactLock": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "version",
        "sha256"
      ],
      "title": "ArtifactLock",
      "type": "object"
    },
    "CapabilityId": {
      "enum": [
        "protocol_analysis",
        "endpoint_classification",
        "estimands_derivation",
        "sap_generation",
        "sdtm_spec_generation",
        "sdtm_programming",
        "adam_spec_generation",
        "adam_programming",
        "ct_alignment",
        "cdisc_validation",
        "tfl_shell_generation",
        "tfl_programming",
        "qc_validation",
        "p21_triage",
        "define_xml_generation",
        "submission_packaging",
        "source_discovery",
        "source_data_import"
      ],
      "title": "CapabilityId",
      "type": "string"
    },
    "CompatibilityRange": {
      "additionalProperties": false,
      "description": "Half-open SemVer range: minimum <= version < maximum_exclusive.",
      "properties": {
        "minimum": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Minimum",
          "type": "string"
        },
        "maximum_exclusive": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Maximum Exclusive",
          "type": "string"
        }
      },
      "required": [
        "minimum",
        "maximum_exclusive"
      ],
      "title": "CompatibilityRange",
      "type": "object"
    },
    "KnowledgeSnapshotLock": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 3,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "fallback_path": {
          "minLength": 1,
          "title": "Fallback Path",
          "type": "string"
        },
        "contract_compatibility": {
          "$ref": "#/$defs/CompatibilityRange"
        }
      },
      "required": [
        "provider",
        "snapshot_id",
        "version",
        "sha256",
        "fallback_path",
        "contract_compatibility"
      ],
      "title": "KnowledgeSnapshotLock",
      "type": "object"
    },
    "RuntimePolicies": {
      "additionalProperties": false,
      "properties": {
        "live_upgrade": {
          "const": "forbidden",
          "default": "forbidden",
          "title": "Live Upgrade",
          "type": "string"
        },
        "conflict": {
          "const": "fail_closed",
          "default": "fail_closed",
          "title": "Conflict",
          "type": "string"
        },
        "version": {
          "const": "exact_manifest",
          "default": "exact_manifest",
          "title": "Version",
          "type": "string"
        },
        "fallback": {
          "const": "locked_snapshot_only",
          "default": "locked_snapshot_only",
          "title": "Fallback",
          "type": "string"
        }
      },
      "title": "RuntimePolicies",
      "type": "object"
    },
    "ToolchainLock": {
      "additionalProperties": false,
      "properties": {
        "registry_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Registry Version",
          "type": "string"
        },
        "git_commit": {
          "pattern": "^[a-f0-9]{7,40}$",
          "title": "Git Commit",
          "type": "string"
        },
        "registry_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Registry Sha256",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/CapabilityId"
          },
          "title": "Capabilities",
          "type": "array"
        }
      },
      "required": [
        "registry_version",
        "git_commit",
        "registry_sha256",
        "capabilities"
      ],
      "title": "ToolchainLock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "manifest_id": {
      "pattern": "^manifest-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Manifest Id",
      "type": "string"
    },
    "schema_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "study_id": {
      "minLength": 1,
      "title": "Study Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "pipeline_contract": {
      "$ref": "#/$defs/ArtifactLock"
    },
    "workflow_knowledge": {
      "$ref": "#/$defs/KnowledgeSnapshotLock"
    },
    "domain_knowledge": {
      "$ref": "#/$defs/KnowledgeSnapshotLock"
    },
    "toolchain": {
      "$ref": "#/$defs/ToolchainLock"
    },
    "policies": {
      "$ref": "#/$defs/RuntimePolicies"
    },
    "manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "manifest_id",
    "schema_version",
    "revision",
    "study_id",
    "created_at",
    "pipeline_contract",
    "workflow_knowledge",
    "domain_knowledge",
    "toolchain",
    "policies",
    "manifest_sha256"
  ],
  "title": "RuntimeManifest",
  "type": "object"
}
