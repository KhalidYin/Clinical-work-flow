{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-workflow/schemas/knowledge/study-decision",
  "$defs": {
    "ApprovalEvidence": {
      "additionalProperties": false,
      "description": "Hash-locked Review artifacts authorizing one Study decision finding.",
      "properties": {
        "review_id": {
          "minLength": 1,
          "title": "Review Id",
          "type": "string"
        },
        "finding_id": {
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "packet_path": {
          "minLength": 1,
          "title": "Packet Path",
          "type": "string"
        },
        "packet_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Packet Sha256",
          "type": "string"
        },
        "decision_path": {
          "minLength": 1,
          "title": "Decision Path",
          "type": "string"
        },
        "decision_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Decision Sha256",
          "type": "string"
        },
        "confirmation_path": {
          "minLength": 1,
          "title": "Confirmation Path",
          "type": "string"
        },
        "confirmation_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Confirmation Sha256",
          "type": "string"
        }
      },
      "required": [
        "review_id",
        "finding_id",
        "packet_path",
        "packet_sha256",
        "decision_path",
        "decision_sha256",
        "confirmation_path",
        "confirmation_sha256"
      ],
      "title": "ApprovalEvidence",
      "type": "object"
    },
    "TEAEWindowRule": {
      "additionalProperties": false,
      "description": "Machine-executable treatment-emergent adverse-event window.",
      "properties": {
        "rule_type": {
          "const": "teae_window",
          "default": "teae_window",
          "title": "Rule Type",
          "type": "string"
        },
        "target_dataset": {
          "const": "ADAE",
          "default": "ADAE",
          "title": "Target Dataset",
          "type": "string"
        },
        "target_variable": {
          "const": "TRTEMFL",
          "default": "TRTEMFL",
          "title": "Target Variable",
          "type": "string"
        },
        "event_start_date": {
          "const": "ADAE.ASTDT",
          "default": "ADAE.ASTDT",
          "title": "Event Start Date",
          "type": "string"
        },
        "treatment_start_date": {
          "const": "ADSL.TRTSDT",
          "default": "ADSL.TRTSDT",
          "title": "Treatment Start Date",
          "type": "string"
        },
        "treatment_end_date": {
          "const": "ADSL.TRTEDT",
          "default": "ADSL.TRTEDT",
          "title": "Treatment End Date",
          "type": "string"
        },
        "start_offset_days": {
          "default": 0,
          "maximum": 365,
          "minimum": -365,
          "title": "Start Offset Days",
          "type": "integer"
        },
        "end_offset_days": {
          "maximum": 365,
          "minimum": 0,
          "title": "End Offset Days",
          "type": "integer"
        },
        "lower_bound_inclusive": {
          "default": true,
          "title": "Lower Bound Inclusive",
          "type": "boolean"
        },
        "upper_bound_inclusive": {
          "default": true,
          "title": "Upper Bound Inclusive",
          "type": "boolean"
        },
        "incomplete_event_date_policy": {
          "const": "review_required",
          "title": "Incomplete Event Date Policy",
          "type": "string"
        },
        "missing_treatment_date_policy": {
          "const": "review_required",
          "title": "Missing Treatment Date Policy",
          "type": "string"
        },
        "multiple_treatment_period_policy": {
          "const": "review_required",
          "title": "Multiple Treatment Period Policy",
          "type": "string"
        },
        "pre_treatment_worsening_policy": {
          "enum": [
            "review_required",
            "include_if_worsened"
          ],
          "title": "Pre Treatment Worsening Policy",
          "type": "string"
        }
      },
      "required": [
        "end_offset_days",
        "incomplete_event_date_policy",
        "missing_treatment_date_policy",
        "multiple_treatment_period_policy",
        "pre_treatment_worsening_policy"
      ],
      "title": "TEAEWindowRule",
      "type": "object"
    },
    "WorkflowStage": {
      "enum": [
        "protocol_analysis",
        "sap_generation",
        "sdtm_spec",
        "sdtm_programming",
        "adam_spec",
        "adam_programming",
        "tfl_shell_design",
        "tfl_programming",
        "qc_validation",
        "submission_packaging"
      ],
      "title": "WorkflowStage",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Study-scoped executable rule whose content and approval are independently locked.",
  "properties": {
    "decision_id": {
      "minLength": 3,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
      "title": "Decision Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "title": "Version",
      "type": "string"
    },
    "study_id": {
      "minLength": 1,
      "title": "Study Id",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/WorkflowStage"
    },
    "priority": {
      "maximum": 1000,
      "minimum": 1,
      "title": "Priority",
      "type": "integer"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "statement": {
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "source_ids": {
      "items": {
        "minLength": 3,
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "structured_rule": {
      "$ref": "#/$defs/TEAEWindowRule"
    },
    "approval_evidence": {
      "$ref": "#/$defs/ApprovalEvidence"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "version",
    "study_id",
    "stage",
    "priority",
    "title",
    "statement",
    "source_ids",
    "structured_rule",
    "approval_evidence",
    "content_sha256"
  ],
  "title": "StudyDecision",
  "type": "object"
}
