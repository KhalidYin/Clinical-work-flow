{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-workflow.local/p7/ae-mapping-spec-draft",
  "title": "P7 P1 Synthetic AE MappingSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_id",
    "schema_version",
    "fixture_id",
    "synthetic_only",
    "target_dataset",
    "standards",
    "p6_context",
    "source_inputs",
    "target_variables",
    "mappings",
    "gaps",
    "expected_outputs"
  ],
  "properties": {
    "spec_id": {"type": "string", "pattern": "^map-spec-[a-z0-9-]+$"},
    "schema_version": {"type": "string", "const": "0.1.0-draft"},
    "fixture_id": {"type": "string", "const": "fixture-synth-ae-001-v1"},
    "synthetic_only": {"type": "boolean", "const": true},
    "target_dataset": {"type": "string", "const": "AE"},
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdtm_version", "sdtmig_version"],
      "properties": {
        "sdtm_version": {"type": "string", "const": "2.0"},
        "sdtmig_version": {"type": "string", "const": "3.4"}
      }
    },
    "p6_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "citation_bundle_id", "query_benchmark_id"],
      "properties": {
        "snapshot_id": {"type": "string", "const": "snapshot-sdtmig34-core-events-ae-v1"},
        "citation_bundle_id": {"type": "string", "const": "ae-citation-bundle-sdtmig34-core-events-ae-v1"},
        "query_benchmark_id": {"type": "string", "const": "query-benchmark-sdtmig34-core-events-ae-v1"}
      }
    },
    "source_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceInput"}
    },
    "target_variables": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/targetVariable"}
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/mapping"}
    },
    "gaps": {
      "type": "array",
      "items": {"$ref": "#/$defs/gap"}
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/expectedOutput"}
    }
  },
  "$defs": {
    "sourceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "role", "path", "sha256"],
      "properties": {
        "input_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "role": {"type": "string", "enum": ["crf_metadata", "edc_dictionary", "raw_dataset", "subject_reference", "study_context"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "targetVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "material"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}$"},
        "status": {"type": "string", "enum": ["mapped", "explicit_gap", "not_in_p7_p1_scope"]},
        "material": {"type": "boolean"},
        "gap_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapping_id", "target_variable", "mapping_type", "material", "rule_refs", "source_refs"],
      "properties": {
        "mapping_id": {"type": "string", "pattern": "^map-ae-[a-z0-9-]+$"},
        "target_variable": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}$"},
        "mapping_type": {"type": "string", "enum": ["constant", "direct", "sequence", "normalize_date", "derive_study_day"]},
        "material": {"type": "boolean"},
        "source_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "rule_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^proposal-sdtmig34-[a-z0-9-]+-v1$"}
        },
        "study_decision_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "algorithm": {"type": "string", "minLength": 1}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_id", "target_variable", "source_gap_id", "blocking"],
      "properties": {
        "gap_id": {"type": "string", "pattern": "^gap-[a-z0-9-]+$"},
        "target_variable": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{1,7}$"},
        "source_gap_id": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"},
        "review_type": {"type": "string", "enum": ["knowledge_gap", "study_context_gap", "ct_gap"]}
      }
    },
    "expectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_id", "path", "sha256", "row_count"],
      "properties": {
        "output_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "row_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}

