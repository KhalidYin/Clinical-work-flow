{
  "$id": "https://clinical-ai-workflow.local/schemas/prerelease/p11/validation-gate-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "FindingSeverity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "info"
      ],
      "title": "FindingSeverity",
      "type": "string"
    },
    "GateDisposition": {
      "enum": [
        "pass",
        "pass_with_findings",
        "auto_rework",
        "human_review"
      ],
      "title": "GateDisposition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "disposition": {
      "$ref": "#/$defs/GateDisposition"
    },
    "disputed_finding_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Disputed Finding Ids",
      "type": "array"
    },
    "finding_ids": {
      "items": {
        "type": "string"
      },
      "title": "Finding Ids",
      "type": "array"
    },
    "max_severity": {
      "anyOf": [
        {
          "$ref": "#/$defs/FindingSeverity"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "rework_attempts": {
      "maximum": 1,
      "minimum": 0,
      "title": "Rework Attempts",
      "type": "integer"
    }
  },
  "required": [
    "disposition",
    "max_severity",
    "finding_ids",
    "rework_attempts",
    "reason_codes"
  ],
  "title": "GateDecision",
  "type": "object"
}
