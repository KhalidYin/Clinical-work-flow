{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-workflow/schemas/source/source-metadata",
  "title": "Clinical Source Metadata Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "generated_at",
    "source",
    "parser",
    "dataset",
    "metadata_availability",
    "variables"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_type": { "const": "source_metadata" },
    "artifact_id": {
      "type": "string",
      "pattern": "^source-metadata-[a-f0-9]{12}$"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/source" },
    "parser": { "$ref": "#/$defs/parser" },
    "dataset": { "$ref": "#/$defs/dataset" },
    "metadata_availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column_labels",
        "formats",
        "informats",
        "value_labels",
        "external_format_catalog"
      ],
      "properties": {
        "column_labels": { "$ref": "#/$defs/availability" },
        "formats": { "$ref": "#/$defs/availability" },
        "informats": { "$ref": "#/$defs/availability" },
        "value_labels": { "$ref": "#/$defs/availability" },
        "external_format_catalog": { "$ref": "#/$defs/availability" }
      }
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/variable" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "format", "sha256", "size_bytes"],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "(^|/)\\.\\.(/|$)" }
        },
        "format": { "enum": ["csv", "sas7bdat", "xpt"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "python_version",
        "library_versions"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "python_version": { "type": "string", "minLength": 3 },
        "library_versions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "column_count",
        "file_label",
        "file_encoding",
        "file_format",
        "table_name"
      ],
      "properties": {
        "row_count": { "type": "integer", "minimum": 0 },
        "column_count": { "type": "integer", "minimum": 1 },
        "file_label": { "type": ["string", "null"] },
        "file_encoding": { "type": ["string", "null"] },
        "file_format": { "type": ["string", "null"] },
        "table_name": { "type": ["string", "null"] }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "available_count", "total_count", "reason"],
      "properties": {
        "status": { "enum": ["available", "unavailable", "not_supplied"] },
        "available_count": { "type": "integer", "minimum": 0 },
        "total_count": { "type": "integer", "minimum": 0 },
        "reason": { "type": ["string", "null"] }
      }
    },
    "status_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "reason"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "value": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "value_labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "label_set", "mapping", "reason"],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "label_set": { "type": ["string", "null"] },
        "mapping": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "reason": { "type": ["string", "null"] }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "name",
        "logical_type",
        "source_storage_type",
        "storage_width",
        "column_label",
        "source_format",
        "source_informat",
        "value_labels"
      ],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "logical_type": { "type": "string", "minLength": 1 },
        "source_storage_type": { "type": ["string", "null"] },
        "storage_width": { "type": ["integer", "null"], "minimum": 0 },
        "column_label": { "$ref": "#/$defs/status_value" },
        "source_format": { "$ref": "#/$defs/status_value" },
        "source_informat": { "$ref": "#/$defs/status_value" },
        "value_labels": { "$ref": "#/$defs/value_labels" }
      }
    }
  }
}
