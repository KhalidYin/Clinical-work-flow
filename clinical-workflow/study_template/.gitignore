# Clinical data and source documents — never commit without Study governance.
input/edc/*
input/external/*
input/protocol/*
input/sap/*
!input/**/.gitkeep

# Runtime caches and generated deliverables are reproducible or subject to
# separate Study release controls.  Keep metadata, review evidence and the
# manifest under version control.
output/**
!output/
!output/**/
!output/**/.gitkeep
*.pyc
__pycache__/
.pytest_cache/

# Never add an implicit legacy state machine back into the Study scaffold.
.workflow/
